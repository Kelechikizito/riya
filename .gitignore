# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs — `forge doc` output at the repo root. Anchored with a leading slash:
# an unanchored `docs/` also matches nested directories, which swallowed
# frontend/app/docs/ and made Tailwind skip that route's classes entirely.
/docs/*
!/docs/brand-guidelines.md

# Dotenv file. The glob catches backups and per-environment variants; the negation keeps the
# committed template. A stray `.env.bak` holding an API key is the leak this prevents.
.env
.env.*
!.env.example

# Optional keystore password file for unattended deploys (see the Makefile)
.keystore-password

# Local Claude Code settings
.claude/settings.local.json

# Node modules
node_modules/

# Worker crash-recovery store (SQLite, regenerated on demand)
*.db
*.db-wal
*.db-shm

# Playwright end-to-end artefacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
