# ---------------------------------------------------------------------------
# riya frontend
#
# Every address below is optional. While the ledger address is unset the
# dashboard runs on the labelled demo dataset instead of rendering an empty
# skeleton — see lib/usePosition.ts.
# ---------------------------------------------------------------------------

# Creditcoin — destination chain. Defaults are the public testnet endpoints.
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CREDITCOIN_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# Deployed contracts (Creditcoin Testnet)
NEXT_PUBLIC_LOAN_LEDGER_ADDRESS=
NEXT_PUBLIC_RIYA_USD_ADDRESS=
NEXT_PUBLIC_RIYA_ASC_ADDRESS=

# Deployed contracts (Ethereum Sepolia) — displayed, not called
NEXT_PUBLIC_RIYA_ESCROW_ADDRESS=
NEXT_PUBLIC_AAVE_ADAPTER_ADDRESS=

# Observed Aave supply APY in basis points. LoanLedger.selfRepayRateBps takes
# this as an argument rather than reading an oracle, so the frontend owns it.
NEXT_PUBLIC_YIELD_RATE_BPS=500

# Optional. Injected wallets work without it; only WalletConnect's QR flow needs
# one. https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
