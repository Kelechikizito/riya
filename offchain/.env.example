# Copy the values you need into the repo-root `.env` (which stays gitignored).
# `config.ts` reads that file, not this one.

# ---------------------------------------------------------------------------
# Source chain — Ethereum only. Sepolia for the demo, Mainnet for production.
# ---------------------------------------------------------------------------
ETH_SEPOLIA_RPC_URL=
# A second endpoint. Optional, but the worker warns without it: a node that quietly
# stops delivering logs looks like a quiet day rather than an error.
ETH_SEPOLIA_RPC_URL_FALLBACK=
SOURCE_CHAIN_ID=11155111

# ---------------------------------------------------------------------------
# Creditcoin
# ---------------------------------------------------------------------------
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Sepolia's key in Creditcoin's registry. 1 on CC3 Testnet; the numbering differs on
# Mainnet, and the worker refuses to start if this disagrees with getSupportedChains()
# or with the deployed RiyaASC.
CHAIN_KEY=1
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------
RIYA_ASC_ADDRESS=
RIYA_ESCROW_ADDRESS=
AAVE_V4_ADAPTER_ADDRESS=

# ---------------------------------------------------------------------------
# Keys — two of them, and they must differ. KEEPER holds ETH, WORKER holds tCTC.
# ---------------------------------------------------------------------------
KEEPER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Worker tunables (all optional; defaults in config.ts)
# ---------------------------------------------------------------------------
# WORKER_DB_PATH=./riya-worker.db
# WORKER_START_BLOCK=0
# WORKER_POLL_INTERVAL_MS=12000
# WORKER_LOG_RANGE=5000
# WORKER_RESCAN_OVERLAP=200
# WORKER_EXTRA_DELAY_MS=3000
# WORKER_ATTESTATION_POLL_MS=15000
# WORKER_ATTESTATION_TIMEOUT_MS=900000
# WORKER_PROOF_ATTEMPTS=6
# WORKER_SUBMIT_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Keeper tunables
# ---------------------------------------------------------------------------
# KEEPER_POLL_INTERVAL_MS=300000
# The keeper's own floor, in USDC's smallest unit. NOT the same as the contract's
# I_MIN_HARVEST: on Mainnet this should sit well above it, because a harvest withdraws
# from Aave and then transfers, which can cost more than the amount it moves.
# KEEPER_THRESHOLD=10000000
