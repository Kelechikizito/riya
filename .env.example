# Copy to `.env` and fill in. `.env` is gitignored; keep it that way.
#
# The deploy targets in the Makefile print addresses. Paste them back in here as you go,
# then `make frontend-env` writes frontend/.env.local from these same values.

# ---------------------------------------------------------------------------
# Endpoints
# ---------------------------------------------------------------------------
ETH_MAINNET_RPC_URL=
ETH_SEPOLIA_RPC_URL=
# A second Sepolia endpoint for the worker. Optional, but a node that quietly stops
# delivering logs looks like a quiet day rather than an error.
ETH_SEPOLIA_RPC_URL_FALLBACK=
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

SOURCE_CHAIN_ID=11155111
# Sepolia's key in Creditcoin Testnet's registry. Verified against the live precompile
# by the fork tests, and asserted again by the deploy script before it spends gas.
CHAIN_KEY=1

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------
# Deploys and runs the interaction scripts. Use a throwaway key.
PRIVATE_KEY=
# The keeper holds Sepolia ETH; the worker holds tCTC. They must differ.
KEEPER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Sepolia mocks — from `make deploy-mocks`
# Aave V4 is live on Ethereum Mainnet and nowhere else, so the demo brings its own.
# ---------------------------------------------------------------------------
MOCK_USD=
MOCK_SPOKE=
MOCK_RESERVE_ID=

# ---------------------------------------------------------------------------
# Ethereum leg — from `make deploy-source`
# ---------------------------------------------------------------------------
RIYA_ESCROW_ADDRESS=
AAVE_V4_ADAPTER_ADDRESS=

# ---------------------------------------------------------------------------
# Creditcoin leg — from `make deploy-destination`
# ---------------------------------------------------------------------------
RIYA_USD_ADDRESS=
RIYA_ASC_ADDRESS=
LOAN_LEDGER_ADDRESS=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The Aave supply APY the dashboard assumes, in basis points. `selfRepayRateBps` takes
# this as an argument rather than reading an oracle, so the UI owns the number.
YIELD_RATE_BPS=500
